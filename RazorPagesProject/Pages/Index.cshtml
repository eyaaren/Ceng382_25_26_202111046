@page
@model RazorPagesProject.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<div class="container mt-4">
    <!-- Add New Class Form -->
    <div class="row justify-content-center">
        <div class="col-md-6 form-wrapper">
            <h2 class="text-center">Add a New Class</h2>
            <form method="post" asp-page="Index">
                <div class="form-group">
                    <label for="ClassName">Class Name</label>
                    <input type="text" id="ClassName" name="ClassName" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="StudentCount">Student Count</label>
                    <input type="number" id="StudentCount" name="StudentCount" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="Description">Description</label>
                    <textarea id="Description" name="Description" class="form-control" required></textarea>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary mt-2" style="background-color: #c0c2d9; color: #3f6687;">Add Class</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Filter and Class List Table -->
    <div class="row justify-content-center mt-5">
        <div class="col-md-10">
            <h2 class="text-center">Class List</h2>

            <!-- Filter Form (GET) -->
            <form method="get" asp-page="Index" class="mb-3">
                <div class="input-group">
                    <input type="text" name="Filter" value="@Model.Filter" class="form-control" placeholder="Search class name..." />
                    <button type="submit" class="btn btn-secondary" style="background-color: #3f6687; color: #f8f6f9;">Filter</button>
                </div>
            </form>

            <table class="table">
                <thead>
                    <tr>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var classInfo in Model.ClassesForDisplay)
                    {
                        <tr>
                            <td>@classInfo.ClassName</td>
                            <td>@classInfo.StudentCount</td>
                            <td>@classInfo.Description</td>
                            <td>
                                <button type="button" class="btn btn-sm"
                                        onclick="openEditModal('@classInfo.Id', '@classInfo.ClassName', '@classInfo.StudentCount', '@classInfo.Description')">
                                    <i class="bi bi-pencil" style="color: #3f6687;"></i>
                                </button>
                            </td>
                            <td>
                                <a asp-page-handler="Delete" asp-route-id="@classInfo.Id" class="btn btn-sm">
                                    <i class="bi bi-trash" style="color: #e74c3c;"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Edit Modal -->
            <div class="modal fade" id="editModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form method="post" asp-page-handler="Edit">
                            <div class="modal-header">
                                <h5 class="modal-title">Edit Class</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="EditClass.Id" id="editId" />
                                <div class="form-group">
                                    <label for="editName">Class Name</label>
                                    <input type="text" name="EditClass.ClassName" id="editName" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label for="editCount">Student Count</label>
                                    <input type="number" name="EditClass.StudentCount" id="editCount" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label for="editDescription">Description</label>
                                    <textarea name="EditClass.Description" id="editDescription" class="form-control" required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">Save</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Pagination -->
            <nav>
                <ul class="pagination justify-content-center">
                    @if (Model.PageNumber > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)&Filter=@Model.Filter">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?PageNumber=@i&Filter=@Model.Filter">@i</a>
                        </li>
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)&Filter=@Model.Filter">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

<style>
    .btn-secondary{
        font-size: 16px;
    }

    .btn-secondary:hover {
        background-color: #c0c2d9 !important;
        color: #3f6687 !important;
        cursor: pointer;
    }
</style>

@section Scripts {
    <script>
        function openEditModal(id, name, count, description) {
            document.getElementById("editId").value = id;
            document.getElementById("editName").value = name;
            document.getElementById("editCount").value = count;
            document.getElementById("editDescription").value = description;

            var editModal = new bootstrap.Modal(document.getElementById('editModal'));
            editModal.show();
        }
    </script>
}
