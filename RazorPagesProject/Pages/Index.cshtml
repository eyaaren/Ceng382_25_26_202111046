@page
@model RazorPagesProject.Pages.IndexModel
@{
   ViewData["Title"] = "Home page";
    var username = HttpContext.Session.GetString("username");
}

@if (!string.IsNullOrEmpty(username))
{
    <p>Welcome, @username!</p>
    <a href="/Logout">Logout</a>
}
@if (!string.IsNullOrEmpty(Model.WelcomeMessage))
{
    <div class="alert alert-success text-center">
        @Model.WelcomeMessage
    </div>
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<div class="container mt-4">
   <!-- Yeni sınıf ekleme formu -->
<form method="post" asp-page="Index">
    <div class="form-group">
        <label for="ClassName">Class Name</label>
        <input type="text" id="Name" name="NewClass.Name" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="StudentCount">Student Count</label>
        <!-- DÜZELTME: name="NewClass.PersonCount" olarak değiştirildi -->
        <input type="number" name="NewClass.PersonCount" id="personCount" class="form-control" required />
    </div>
    <div class="form-group">
        <label for="Description">Description</label>
        <textarea id="Description" name="NewClass.Description" class="form-control" required></textarea>
    </div>
    <div class="text-center">
        <button type="submit" class="btn btn-primary mt-2" style="background-color: #c0c2d9; color: #3f6687;">Add Class</button>
    </div>
</form>
    <!-- Filter and Class List Table -->
    <div class="row justify-content-center mt-5">
        <div class="col-md-10">
            <h2 class="text-center">Class List</h2>

            <!-- Filter Form (GET) -->
            <form method="get" asp-page="Index" class="mb-3">
                <div class="input-group">
                    <input type="text" name="Filter" value="@Model.Filter" class="form-control" placeholder="Search class name..." />
                    <button type="submit" class="btn btn-secondary" style="background-color: #3f6687; color: #f8f6f9;">Filter</button>
                </div>
            </form>

            <table class="table" id="classTable">
                <thead>
                    <tr>
                        <th class="column-header" data-column="ClassName">Class Name</th>
                        <th class="column-header" data-column="StudentCount">Student Count</th>
                        <th class="column-header" data-column="Description">Description</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                   @foreach (var classInfo in Model.ClassList)
{
    <tr>
        <td>@classInfo.Name</td>
        <td>@classInfo.PersonCount</td>
        <td>@classInfo.Description</td>
       <td>
    <button type="button" class="btn btn-sm edit-button"
            data-id="@classInfo.Id"
            data-name="@classInfo.Name"
            data-count="@classInfo.PersonCount"
            data-description="@classInfo.Description"
            onclick="openEditModal(this)">
        <i class="bi bi-pencil" style="color: #3f6687;"></i>
    </button>
</td>



        <td>
            <a asp-page-handler="Delete" asp-route-id="@classInfo.Id" class="btn btn-sm">
                <i class="bi bi-trash" style="color: #e74c3c;"></i>
            </a>
        </td>
    </tr>
}

                </tbody>
            </table>

           <!-- Düzenleme modal formu -->
<form method="post" asp-page-handler="Edit">
    <div class="modal-header">
        <h5 class="modal-title">Edit Class</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>
    <div class="modal-body">
        <input type="hidden" name="EditClass.Id" id="editId" />
        <div class="form-group">
            <label for="editName">Class Name</label>
            <input type="text" name="EditClass.Name" id="editName" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="editCount">Student Count</label>
            <!-- DÜZELTME: name="EditClass.PersonCount" olarak değiştirildi -->
            <input type="number" name="EditClass.PersonCount" id="editCount" class="form-control" required />
        </div>
        <div class="form-group">
            <label for="editDescription">Description</label>
            <textarea name="EditClass.Description" id="editDescription" class="form-control" required></textarea>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
    </div>
</form>
            <!-- Single Export Button -->
            <button id="export" class="btn btn-secondary" style="background-color: #3f6687; color: #f8f6f9; font-size: 16px;">Export</button>

            <!-- Pagination -->
            <nav>
                <ul class="pagination justify-content-center">
                    @if (Model.PageNumber > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)&Filter=@Model.Filter">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                            <a class="page-link" href="?PageNumber=@i&Filter=@Model.Filter">@i</a>
                        </li>
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)&Filter=@Model.Filter">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
</div>

<style>
    .btn-secondary {
        font-size: 16px;
    }

    .btn-secondary:hover {
        background-color: #c0c2d9 !important;
        color: #3f6687 !important;
        cursor: pointer;
    }

    .form-wrapper {
        max-width: 400px; /* Smaller width for the form */
        padding: 20px; /* Adjusted padding */
    }

    /* Add styles for the selected column */
    .column-header.selected {
        background-color: #c0c2d9;
        color: #3f6687;
        cursor: pointer;
    }
</style>


@section Scripts {
    <script>

       // Edit modal open function
function openEditModal(button) {
    const id = button.dataset.id;
    const name = button.dataset.name;
    const count = button.dataset.count;
    const description = button.dataset.description;

    document.getElementById('editId').value = id;
    document.getElementById('editName').value = name;
    document.getElementById('editCount').value = count; // editCount ID'si kullanılıyor
    document.getElementById('editDescription').value = description;

    var editModal = new bootstrap.Modal(document.getElementById('editModal'));
    editModal.show();
}




        // Export Data (Filtered or Unfiltered)
        document.getElementById('export').addEventListener('click', function() {
            const selectedColumns = [];
            document.querySelectorAll('.column-header.selected').forEach(header => {
                selectedColumns.push(header.getAttribute('data-column'));
            });

            const isFiltered = '@Model.Filter'.length > 0;

            fetch('/Index?handler=ExportData', {
                method: 'POST',
                body: JSON.stringify({ selectedColumns, isFiltered }),
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.blob())
            .then(blob => {
                const link = document.createElement('a');
                link.href = URL.createObjectURL(blob);
                link.download = 'exported_data.json';
                link.click();
            });
        });
    </script>
}
