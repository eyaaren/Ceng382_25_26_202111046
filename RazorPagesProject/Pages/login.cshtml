@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="custom-login-card p-4 shadow" style="width: 100%; max-width: 400px;">
        <h2 class="text-center mb-4 text-white">Login</h2>

        <form method="post">
            <div class="mb-3">
                <label class="form-label text-white">Username:</label>
                <input type="text" name="Username" class="form-control custom-input" required />
            </div>
            <div class="mb-3">
                <label class="form-label text-white">Password:</label>
                <input type="password" name="Password" class="form-control custom-input" required />
            </div>
            <div class="d-grid">
                <button type="submit" class="custom-btn btn">Login</button>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="text-danger mt-3 text-center">@Model.ErrorMessage</p>
            }
        </form>
    </div>
</div>

<style>
    body {
        background-color:  #e6e2e4; /* Açık gri arka plan */
    }

    .custom-login-card {
        background-color: #c0c2d9;
        border-radius: 25px !important; /* Border radius arttırıldı */
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        border: 5px solid #3f6687 !important; /* Border rengi ve kalınlık */
    }

    /* Inputlara border eklemek için custom sınıf */
    .custom-input {
        border: 5px solid #3f6687 !important; /* Inputlar için border */
        border-radius: 10px !important; /* Inputlar için yuvarlak köşe */
    }

    .custom-input:focus {
        border-color: #52557c !important; /* Inputlar focus olduğunda renk değişir */
        box-shadow: 0 0 5px rgba(82, 85, 124, 0.5) !important; /* Focus efekti */
    }

    .custom-btn {
        background-color: #3f6687;
        color: #fff;
    }

    .custom-btn:hover {
        background-color: #52557c;
        color: #fff;
    }
</style>
